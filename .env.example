# Copy to .env and fill in. The .env file is gitignored.

# Required for `fdatrack assess` (the agent loop). The six tools and the
# eval suite work without it.
ANTHROPIC_API_KEY=

# Optional: raises the openFDA limit from 1,000 to 120,000 requests/day.
# Free at https://open.fda.gov/apis/authentication/
FDA_API_KEY=

# Optional: model for the assess loop (default claude-sonnet-5)
# FDATRACK_MODEL=claude-sonnet-5
